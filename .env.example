PORT=4000
NODE_ENV=development

# MySQL
DATABASE_URL=mysql://gcb:password@localhost:3306/gcb

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# Tenant resolution
DEFAULT_TENANT_SLUG=gyb
ROOT_DOMAIN=gcb.app

# Logging: trace|debug|info|warn|error; TRUST_PROXY=1 when behind a load balancer
LOG_LEVEL=info
TRUST_PROXY=0

# CORS
CORS_ORIGINS=http://localhost:3000,http://gyb.localhost:3000
# HMAC key for NIN/VIN hashes (generate a random 32-byte hex string)
KYC_PEPPER=change-me-too
