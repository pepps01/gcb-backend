PORT=4000
NODE_ENV=development

# MySQL
DATABASE_URL=mysql://gcb:password@localhost:3310/gcb
# Optional: CA certificate (PEM, "\n" escapes allowed) for a managed MySQL that requires TLS, e.g. Aiven
DATABASE_CA=

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# Tenant resolution
DEFAULT_TENANT_SLUG=syb
ROOT_DOMAIN=gcb.app

# Logging: trace|debug|info|warn|error; TRUST_PROXY=1 when behind a load balancer
LOG_LEVEL=info
TRUST_PROXY=0

# CORS
CORS_ORIGINS=http://localhost:3000,http://syb.localhost:3000
# HMAC key for NIN/VIN hashes (generate a random 32-byte hex string)
KYC_PEPPER=change-me-too
# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Chat messages per member per minute
MESSAGE_RATE_LIMIT=30

# Optional: `npm run seed` makes this phone the syb tenant_admin (creating the user if needed)
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Tenant Admin

# Private uploads (KYC documents) directory, until S3
UPLOAD_DIR=uploads
